# =============================================================================
# SecureChat AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Supabase (Required) ---
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- App (Required) ---
VITE_APP_NAME=SecureChat AI
VITE_APP_URL=http://localhost:5179

# --- OpenRouter AI (Required for AI features) ---
# AI threat analysis is powered by OpenRouter (openai/gpt-4o-mini).
# Set to true to enable AI analysis of messages.
# The OPENROUTER_API_KEY is set as a Supabase Edge Function secret.
VITE_OPENROUTER_ENABLED=true

# --- Razorpay (Required for Premium payments) ---
# Get test keys: https://razorpay.com/docs/api-details
# Get live keys from Razorpay Dashboard
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- Web Push Notifications (Required for push) ---
# Generate VAPID keys: https://web-push-codelab.glitch.me/
# Or use: npx web-push generate-vapid-keys
# The VAPID_PRIVATE_KEY is set as a Supabase Edge Function secret.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# --- WebSocket (Optional - Supabase Realtime is primary) ---
VITE_SOCKET_URL=http://localhost:3001

# --- Feature Flags (Optional - defaults to true) ---
VITE_ENABLE_E2E=true
VITE_ENABLE_VOICE=true
VITE_ENABLE_LOCATION=true

# --- Monitoring (Optional - leave empty to disable) ---
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://app.posthog.com
